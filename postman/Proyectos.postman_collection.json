{
  "info": {
    "name": "Proyectos - Taller práctico Spring Boot",
    "description": "Ejecutar primero las peticiones 1 a 4, una vez cada una. Los IDs se guardan automáticamente. Tomar captura completa en la petición 4, mostrando el JSON con proyecto y empleados. Las demás peticiones son comprobaciones adicionales. Los fallos de negocio responden 500 con detalle, según el documento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "empleadoId",
      "value": ""
    },
    {
      "key": "proyectoId",
      "value": ""
    },
    {
      "key": "empleadoTemporalId",
      "value": ""
    },
    {
      "key": "proyectoTemporalId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registrar empleado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/empleados",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Diana Rojas\",\n  \"cargo\": \"Desarrollador Senior\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"empleadoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Registrar proyecto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/proyectos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"E-Commerce Plataforma\",\n  \"descripcion\": \"Desarrollo del nuevo portal de ventas online\",\n  \"fechaInicio\": \"2026-05-20\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"proyectoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Registrar tarea con relaciones",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tareas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Diseñar e implementar el modelo de datos para la base de datos\",\n  \"fechaLimite\": \"2026-06-15\",\n  \"costoEstimado\": 450.5,\n  \"proyecto\": {\n    \"id\": \"{{proyectoId}}\"\n  },\n  \"empleados\": [\n    {\n      \"id\": \"{{empleadoId}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Consultar tareas - CAPTURA FINAL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tareas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Tarea con proyecto y empleados\", () => { const datos = pm.response.json(); const tarea = datos.find(t => String(t.proyecto.id) === String(pm.collectionVariables.get(\"proyectoId\"))); pm.expect(tarea).to.exist; pm.expect(tarea.proyecto.nombre).to.eql(\"E-Commerce Plataforma\"); pm.expect(tarea.empleados.some(e => String(e.id) === String(pm.collectionVariables.get(\"empleadoId\")))).to.eql(true); });"
            ]
          }
        }
      ]
    },
